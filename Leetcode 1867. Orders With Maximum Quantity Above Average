--soln--
with cte as (select order_id,sum(quantity)/count(distinct product_id) as avg_qty,max(quantity) as max_qty
from OrdersDetails
group by order_id)

SELECT order_id
FROM cte
WHERE max_qty > (
    SELECT AVG(avg_qty)
    FROM cte
);
